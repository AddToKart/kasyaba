# ─────────────────────────────────────────────────────────────
# Kasyaba Production Environment Variables (.env)
# Copy this file to .env on your VPS:
#   cp .env.production.example .env
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
PORT=3000

# ── Domain & HTTPS (Used by Caddy for auto-SSL) ───────────────
# Enter your real domain or subdomain that points to this VPS IP.
# Example: api.kasyaba.app
DOMAIN=api.yourdomain.com

# ── Supabase Database Connection ──────────────────────────────
# In Supabase Project Settings > Database:
#
# 1. DATABASE_URL (Transaction / Session Pooler - port 6543):
#    Used by the running API and worker for day-to-day queries.
#    postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL (Direct Connection - port 5432):
#    Used by the migration container (Prisma migrate deploy requires a direct connection, not a pooler).
#    postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ── JWT Authentication Secret ─────────────────────────────────
# Must be at least 32 characters long. Generate one with:
#   openssl rand -hex 32
JWT_ACCESS_SECRET="generate-a-secure-random-secret-at-least-32-chars-long"

# Token Expiry Durations
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# ── Resend Email (For Password Reset OTPs) ───────────────────
# Get your API key at https://resend.com
RESEND_API_KEY="re_your_resend_api_key_here"
RESEND_FROM_EMAIL="Kasyaba <noreply@yourdomain.com>"
APP_NAME="Kasyaba"

# ── CORS & Proxy Settings ─────────────────────────────────────
# For mobile apps, '*' is fine since mobile apps don't enforce browser CORS,
# or specify your web portal domain: https://kasyaba.app
CORS_ALLOWED_ORIGINS="*"

# Trust 1 reverse proxy hop (Caddy or Nginx sitting in front of Node)
TRUST_PROXY=1

# Support & Admin email (shown in /privacy and /account-deletion)
SUPPORT_EMAIL=support@yourdomain.com

# ── Background Worker & Crons ─────────────────────────────────
LOG_LEVEL=info
WORKER_TIMEZONE=Asia/Manila
SNAPSHOT_CRON="10 0 * * *"

