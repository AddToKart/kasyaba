generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AccountType {
  cash
  bank
  ewallet
  other
}

enum GoalStatus {
  active
  completed
  paused
  cancelled
}

enum BillRecurrence {
  none
  weekly
  monthly
}

enum BillInstanceStatus {
  upcoming
  paid
  overdue
  cancelled
}

enum AlertType {
  budget_overrun
  low_balance
  savings_goal
  bill_due
  month_end
}

enum AlertSeverity {
  info
  warning
  critical
}

enum JobStatus {
  running
  completed
  failed
}

model User {
  id                     String   @id @default(uuid())
  email                  String   @unique
  passwordHash           String?
  googleSubject          String?  @unique
  displayName            String?
  avatarUrl              String?
  timezone               String   @default("Asia/Manila")
  currencyCode           String   @default("PHP")
  minimumBalanceThreshold Decimal  @default(0) @db.Decimal(14, 2)
  salaryAmount            Decimal? @db.Decimal(14, 2)
  paydayFrequency        String?  @default("semi-monthly")
  paydaySchedule         String?  @default("15th & 30th")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  lastLoginAt            DateTime?

  authSessions          AuthSession[]
  financialAccounts     FinancialAccount[]
  incomeEntries         IncomeEntry[]
  expenseEntries        ExpenseEntry[]
  expenseCategories     ExpenseCategory[]
  budgets               Budget[]
  savingsGoals          SavingsGoal[]
  savingsContributions  SavingsContribution[]
  billTemplates         BillTemplate[]
  billInstances         BillInstance[]
  financialSnapshots    FinancialSnapshot[]
  financialAlerts       FinancialAlert[]

  @@map("users")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String
  refreshTokenHash String
  deviceName       String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  lastUsedAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("auth_sessions")
}

model FinancialAccount {
  id             String      @id @default(uuid())
  userId         String
  name           String
  type           AccountType @default(cash)
  openingBalance Decimal     @default(0) @db.Decimal(14, 2)
  currencyCode   String      @default("PHP")
  isArchived     Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user                User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  incomeEntries       IncomeEntry[]
  expenseEntries      ExpenseEntry[]
  savingsContributions SavingsContribution[]

  @@index([userId])
  @@map("financial_accounts")
}

model IncomeEntry {
  id                   String   @id @default(uuid())
  userId               String
  accountId            String
  amount               Decimal  @db.Decimal(14, 2)
  source               String
  receivedAt           DateTime
  notes                String?
  recurringTemplateId  String?
  clientMutationId     String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  account FinancialAccount  @relation(fields: [accountId], references: [id])

  @@index([userId, receivedAt])
  @@index([clientMutationId])
  @@map("income_entries")
}

model ExpenseCategory {
  id         String  @id @default(uuid())
  userId     String?
  name       String
  iconKey    String  @default("receipt")
  isArchived Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user          User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  expenseEntries ExpenseEntry[]

  @@unique([userId, name])
  @@map("expense_categories")
}

model ExpenseEntry {
  id                   String   @id @default(uuid())
  userId               String
  accountId            String
  categoryId           String
  amount               Decimal  @db.Decimal(14, 2)
  description          String
  spentAt              DateTime
  notes                String?
  recurringTemplateId  String?
  clientMutationId     String?  @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account  FinancialAccount @relation(fields: [accountId], references: [id])
  category ExpenseCategory  @relation(fields: [categoryId], references: [id])

  @@index([userId, spentAt])
  @@index([clientMutationId])
  @@map("expense_entries")
}

model Budget {
  id         String   @id @default(uuid())
  userId     String
  categoryId String?
  period     String   @default("monthly")
  amount     Decimal  @db.Decimal(14, 2)
  startsOn   DateTime
  endsOn     DateTime?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("budgets")
}

model SavingsGoal {
  id           String     @id @default(uuid())
  userId       String
  name         String
  targetAmount Decimal    @db.Decimal(14, 2)
  targetDate   DateTime?
  status       GoalStatus @default(active)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]

  @@index([userId])
  @@map("savings_goals")
}

model SavingsContribution {
  id           String   @id @default(uuid())
  goalId       String
  userId       String
  accountId    String?
  amount       Decimal  @db.Decimal(14, 2)
  contributedAt DateTime
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  goal    SavingsGoal      @relation(fields: [goalId], references: [id], onDelete: Cascade)
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  account FinancialAccount? @relation(fields: [accountId], references: [id])

  @@index([goalId])
  @@index([userId])
  @@map("savings_contributions")
}

model BillTemplate {
  id              String         @id @default(uuid())
  userId          String
  name            String
  defaultAmount   Decimal        @db.Decimal(14, 2)
  categoryId      String?
  recurrence      BillRecurrence @default(monthly)
  dayOfWeek       Int?
  dayOfMonth      Int?
  startsOn        DateTime
  endsOn          DateTime?
  reminderLeadDays Int            @default(1)
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  instances BillInstance[]

  @@index([userId])
  @@map("bill_templates")
}

model BillInstance {
  id         String             @id @default(uuid())
  userId     String
  templateId String?
  name       String
  amount     Decimal            @db.Decimal(14, 2)
  dueDate    DateTime
  status     BillInstanceStatus @default(upcoming)
  paidAt     DateTime?
  expenseEntryId String?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  template BillTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([userId, dueDate, status])
  @@map("bill_instances")
}

model FinancialSnapshot {
  id                         String   @id @default(uuid())
  userId                     String
  snapshotDate               DateTime
  actualBalance              Decimal  @db.Decimal(14, 2)
  incomeMonthToDate          Decimal  @db.Decimal(14, 2)
  expensesMonthToDate        Decimal  @db.Decimal(14, 2)
  savingsMonthToDate         Decimal  @db.Decimal(14, 2)
  projectedMonthEndIncome    Decimal  @db.Decimal(14, 2)
  projectedMonthEndExpenses  Decimal  @db.Decimal(14, 2)
  predictedMonthEndBalance   Decimal  @db.Decimal(14, 2)
  healthScore                Int?
  healthGrade                String?
  calculationVersion         String   @default("1.0.0")
  calculationDetails         Json?
  createdAt                  DateTime @default(now())

  user   User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts FinancialAlert[]

  @@unique([userId, snapshotDate])
  @@index([userId, snapshotDate(desc)])
  @@map("financial_snapshots")
}

model FinancialAlert {
  id               String        @id @default(uuid())
  userId           String
  snapshotId       String?
  type             AlertType
  severity         AlertSeverity @default(warning)
  title            String
  message          String
  reasonData       Json?
  effectiveDate    DateTime
  deduplicationKey String
  readAt           DateTime?
  dismissedAt      DateTime?
  resolvedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshot FinancialSnapshot? @relation(fields: [snapshotId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt(desc)])
  @@index([deduplicationKey])
  @@map("financial_alerts")
}

model JobRun {
  id              String    @id @default(uuid())
  jobName         String
  startedAt       DateTime  @default(now())
  finishedAt      DateTime?
  status          JobStatus @default(running)
  processedCount  Int       @default(0)
  failedCount     Int       @default(0)
  errorSummary    String?

  @@index([jobName, startedAt(desc)])
  @@map("job_runs")
}
