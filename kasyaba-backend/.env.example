# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=3000
# Creates demo@kasyaba.com / Password123! when true. Keep false unless you are
# working against a disposable local database.
SEED_DEMO_USER=false
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kasyaba
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/kasyaba
JWT_ACCESS_SECRET=your-access-secret-min-32-chars-long-replace-me
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Optional: enables POST /api/v1/auth/google. The Web client ID from Google
# Cloud Console (the Android client is configured in the Flutter app).
GOOGLE_WEB_CLIENT_ID=

# Comma-separated list. Required to be explicit (no '*') when NODE_ENV=production.
CORS_ALLOWED_ORIGINS=*

# Reverse-proxy hops for correct client IPs in rate limiting and logs:
#   false -> API is directly exposed (local development)
#   1     -> one trusted proxy in front (nginx, Coolify/Dokploy, PaaS ingress)
#   true  -> trust all proxies (only if the API cannot be reached directly)
TRUST_PROXY=false

# Shown on the public /privacy and /account-deletion pages.
SUPPORT_EMAIL=support@kasyaba.app

LOG_LEVEL=info
WORKER_TIMEZONE=Asia/Manila
SNAPSHOT_CRON=10 0 * * *
